
# ============================================
# BiliNote 后端配置
# ============================================

# --- 服务器配置 ---
ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8483

# --- 数据库配置 ---
# 每个实例需要独立的数据库文件
DATABASE_URL=sqlite:///bili_note.db

# --- 静态文件与上传配置 ---
# URL 前缀（外部访问路径）
STATIC=/static
UPLOADS=/uploads
# 本地目录名称
STATIC_DIR=static
UPLOADS_DIR=uploads
# 截图输出目录
OUT_DIR=./static/screenshots

# --- 图片与封面配置 ---
IMAGE_BASE_URL=/static/screenshots
API_BASE_URL=http://127.0.0.1:8000
SCREENSHOT_BASE_URL=http://127.0.0.1:8000/static/screenshots

# --- 数据与模型目录 ---
# 每个实例需要独立的数据目录
DATA_DIR=data
MODEL_DIR=
APP_DATA_DIR=

# --- 笔记输出 ---
# 每个实例需要独立的笔记输出目录
NOTE_OUTPUT_DIR=note_results

# --- 日志目录 ---
LOG_DIR=logs

# --- 转录器配置 ---
TRANSCRIBER_TYPE=fast-whisper
WHISPER_MODEL_SIZE=base
